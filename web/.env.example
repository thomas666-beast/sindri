# ─────────────────────────────────────────────────────────────────────
# Frontend environment (Vite)
#
# Copy this file to .env (or .env.local for personal overrides).
# Only variables prefixed with VITE_ are exposed to the browser bundle.
# ─────────────────────────────────────────────────────────────────────

# Backend URL the Vite dev server proxies /api and /uploads to.
# Required for local dev. Not used in production builds (use a reverse proxy).
VITE_API_URL=http://localhost:8080
VITE_MATRIX_RAIN_WITH_CANVAS=true

VITE_APP_BRAND_NAME=sindri
VITE_APP_BRAND_TAGLINE="// a marketplace for makers"
